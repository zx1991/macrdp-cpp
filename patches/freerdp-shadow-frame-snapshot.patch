 /**
  * Function description
  *
  * @return TRUE on success (or nothing need to be updated)
  */
+static BOOL shadow_client_snapshot_surface(rdpShadowClient* client, rdpShadowSurface* surface)
+{
+	WINPR_ASSERT(client);
+	WINPR_ASSERT(surface);
+
+	if (!surface->data || surface->scanline == 0 || surface->height == 0 ||
+	    surface->height > SIZE_MAX / surface->scanline)
+		return FALSE;
+
+	const size_t required = (size_t)surface->scanline * surface->height;
+	if (client->macrdpFrameDataSize < required)
+	{
+		BYTE* buffer = (BYTE*)realloc(client->macrdpFrameData, required);
+		if (!buffer)
+			return FALSE;
+		client->macrdpFrameData = buffer;
+		client->macrdpFrameDataSize = required;
+	}
+
+	for (UINT32 row = 0; row < surface->height; row++)
+	{
+		memcpy(client->macrdpFrameData + ((size_t)row * surface->scanline),
+		       surface->data + ((size_t)row * surface->scanline), surface->scanline);
+	}
+
+	client->macrdpFrameDataWidth = surface->width;
+	client->macrdpFrameDataHeight = surface->height;
+	client->macrdpFrameDataStride = surface->scanline;
+	return TRUE;
+}
