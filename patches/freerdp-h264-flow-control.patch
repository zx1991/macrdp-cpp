+static UINT64 shadow_client_h264_payload_bytes(const RDPGFX_SURFACE_COMMAND* command)
+{
+	if (!command || !command->extra)
+		return 0;
+	if (command->codecId == RDPGFX_CODECID_AVC420)
+	{
+		const RDPGFX_AVC420_BITMAP_STREAM* avc420 =
+			(const RDPGFX_AVC420_BITMAP_STREAM*)command->extra;
+		return avc420->length;
+	}
+	if (command->codecId == RDPGFX_CODECID_AVC444 ||
+	    command->codecId == RDPGFX_CODECID_AVC444v2)
+	{
+		const RDPGFX_AVC444_BITMAP_STREAM* avc444 =
+			(const RDPGFX_AVC444_BITMAP_STREAM*)command->extra;
+		return (UINT64)avc444->bitstream[0].length + avc444->bitstream[1].length;
+	}
+	return 0;
+}
