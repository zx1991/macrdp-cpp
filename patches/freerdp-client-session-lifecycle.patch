 static BOOL shadow_client_h264_wait_idle(rdpShadowClient* client);
 
+enum
+{
+	MACRDP_CLIENT_SESSION_NEW = 0,
+	MACRDP_CLIENT_SESSION_ACTIVE = 1,
+	MACRDP_CLIENT_SESSION_STOPPING = 2,
+	MACRDP_CLIENT_SESSION_STOPPED = 3
+};
+
+BOOL macrdp_shadow_client_session_start(rdpShadowClient* client)
+{
+	if (!client)
+		return FALSE;
+	return InterlockedCompareExchange(&client->macrdpSessionState,
+	                                  MACRDP_CLIENT_SESSION_ACTIVE,
+	                                  MACRDP_CLIENT_SESSION_NEW) ==
+	       MACRDP_CLIENT_SESSION_NEW;
+}
+
+BOOL macrdp_shadow_client_session_begin_stop(rdpShadowClient* client)
+{
+	if (!client)
+		return FALSE;
+	return InterlockedCompareExchange(&client->macrdpSessionState,
+	                                  MACRDP_CLIENT_SESSION_STOPPING,
+	                                  MACRDP_CLIENT_SESSION_ACTIVE) ==
+	       MACRDP_CLIENT_SESSION_ACTIVE;
+}
+
+void macrdp_shadow_client_session_finish_stop(rdpShadowClient* client)
+{
+	if (client)
+		InterlockedExchange(&client->macrdpSessionState, MACRDP_CLIENT_SESSION_STOPPED);
+}
+
+BOOL macrdp_shadow_client_session_is_active(rdpShadowClient* client)
+{
+	return client && InterlockedCompareExchange(&client->macrdpSessionState, 0, 0) ==
+	                     MACRDP_CLIENT_SESSION_ACTIVE;
+}
