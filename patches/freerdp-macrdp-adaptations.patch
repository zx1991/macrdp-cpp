+    takeStatus = macrdp_h264_worker_take(
+        (macrdp_h264_worker*)client->macrdpH264Worker, &encoded);
+    macrdp_h264_worker_get_stats(
+        (macrdp_h264_worker*)client->macrdpH264Worker, &stats);
