+            return FALSE;
+    }
+    else if (codec == RDPGFX_CODECID_AVC444 || codec == RDPGFX_CODECID_AVC444v2)
+    {
+        if (shadow_encoder_prepare(client->encoder, FREERDP_CODEC_AVC444) < 0)
+            return FALSE;
+    }
+    else
+        return FALSE;
+
+    rowBytes = (size_t)nWidth * 4U;
+    if (rowBytes > nSrcStep || rows > (SIZE_MAX - rowBytes) / nSrcStep)
+        return FALSE;
+    frameSize = rows * nSrcStep + rowBytes;
+
+    pending = (MACRDP_H264_PENDING*)calloc(1, sizeof(MACRDP_H264_PENDING));
+    if (!pending)
+        return FALSE;
+    pending->command = *cmd;
+    pending->start = *cmdstart;
+    pending->end = *cmdend;
+
+    submitStatus = macrdp_h264_worker_submit(
+        (macrdp_h264_worker*)client->macrdpH264Worker, pSrcData, frameSize, nSrcStep, nWidth,
+        nHeight, SrcFormat, codec, encodeRegion);
+    if (submitStatus == 0)
