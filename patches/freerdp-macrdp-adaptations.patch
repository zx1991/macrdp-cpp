+static void transport_write_queue_clear(rdpTransport* transport)
+{
+	rdpTransportWriteItem* item = transport->writeQueueHead;
+	while (item)
+	{
+		rdpTransportWriteItem* next = item->next;
+		Stream_Release(item->stream);
+		free(item);
+		item = next;
+	}
+	transport->writeQueueHead = nullptr;
+	transport->writeQueueTail = nullptr;
+	transport->writeQueueBytes = 0;
