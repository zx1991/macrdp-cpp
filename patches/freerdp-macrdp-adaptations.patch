+static int transport_write_queue_drain(rdpTransport* transport, BOOL wait)
+{
+	/* MACRDP_NONBLOCKING_WRITE_QUEUE */
+	/* MACRDP_WRITE_QUEUE_COPY: queued bytes must not alias a reusable wStream. */
+	size_t budget = wait ? SIZE_MAX : MACRDP_WRITE_BUDGET;
+	while (transport->writeQueueHead)
+	{
+		rdpTransportWriteItem* item = transport->writeQueueHead;
+		while (item->offset < item->length)
+		{
+			if (!wait && budget == 0)
+				return 0;
+
+			if (BIO_write_blocked(transport->frontBio))
+			{
+				const long flushStatus = BIO_flush(transport->frontBio);
+				if (flushStatus < 1)
+				{
+					if (!BIO_should_retry(transport->frontBio))
+						return -1;
+					if (!wait)
+						return 0;
+					const long waitStatus = BIO_should_read(transport->frontBio)
+						                         ? BIO_wait_read(transport->frontBio, 100)
+						                         : BIO_wait_write(transport->frontBio, 100);
+					if (waitStatus < 0)
+						return -1;
+					continue;
+				}
+				if (BIO_write_blocked(transport->frontBio))
+				{
+					if (!wait)
+						return 0;
+					const long waitStatus = BIO_should_read(transport->frontBio)
+						                         ? BIO_wait_read(transport->frontBio, 100)
+						                         : BIO_wait_write(transport->frontBio, 100);
+					if (waitStatus < 0)
+						return -1;
+					continue;
+				}
+			}
+
+			ERR_clear_error();
+			const size_t remaining = item->length - item->offset;
+			const size_t chunk =
+				(remaining > MACRDP_WRITE_CHUNK) ? MACRDP_WRITE_CHUNK : remaining;
+			const size_t bounded = (chunk > budget) ? budget : chunk;
+			const int towrite = (int)bounded;
+			const int status = BIO_write(transport->frontBio,
+			                             item->data + item->offset,
+			                             towrite);
+			if (status > 0)
+			{
+				if ((size_t)status > remaining)
+					return -1;
+				item->offset += (size_t)status;
+				transport->writeQueueBytes -= (size_t)status;
+				if (!wait)
+					budget -= (size_t)status;
+				continue;
+			}
+
+			if (!BIO_should_retry(transport->frontBio))
+				return -1;
+			if (!wait)
+				return 0;
+
+			const long waitStatus = BIO_should_read(transport->frontBio)
+		                              ? BIO_wait_read(transport->frontBio, 100)
+		                              : BIO_wait_write(transport->frontBio, 100);
+			if (waitStatus < 0)
+				return -1;
+		}
+
+		transport->writeQueueHead = item->next;
+		if (!transport->writeQueueHead)
+			transport->writeQueueTail = nullptr;
+		free(item->data);
+		free(item);
+	}
+
+	return 1;
+}
