+    size_t frameSize = 0;
+    const size_t rows = nHeight > 0 ? (size_t)nHeight - 1 : 0;
+    int submitStatus = 0;
+
+    if (!client || !pSrcData || !encodeRegion || !cmd || !cmdstart || !cmdend ||
+        !client->macrdpH264Worker || nWidth == 0 || nHeight == 0 || nSrcStep == 0)
+        return FALSE;
+
+    pending = (MACRDP_H264_PENDING*)client->macrdpH264Pending;
+    if (pending && macrdp_h264_worker_busy((macrdp_h264_worker*)client->macrdpH264Worker))
+    {
+        client->macrdpH264DeferredFrames++;
+        shadow_client_h264_defer(pending, pSrcData, nSrcStep, SrcFormat, nWidth, nHeight,
+                                 encodeRegion);
