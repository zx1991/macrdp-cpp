+                                                     &pending->start, &pending->end);
+        }
+        pending->command.extra = nullptr;
+    }
+
+    macrdp_h264_encoded_frame_free(&encoded);
+    client->macrdpH264Pending = nullptr;
+    free(pending);
+    if (error)
+    {
+        WLog_ERR(TAG, "SurfaceFrameCommand failed with error %" PRIu32 "", error);
+        return FALSE;
+    }
