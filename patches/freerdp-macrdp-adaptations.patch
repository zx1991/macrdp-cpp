+static void PublishPending(rdpShadowMultiClientEvent* event)
+{
+	if (event->consuming != 0 || event->waiting != 0 || !event->pending)
+		return;
+
+	Publish(event);
+	/* MACRDP_PENDING_FRAME_EVENT */
+}
