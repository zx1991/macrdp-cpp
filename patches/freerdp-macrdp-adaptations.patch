+static void shadow_client_h264_defer(MACRDP_H264_PENDING* pending, const BYTE* pSrcData,
+                                    UINT32 nSrcStep, UINT32 SrcFormat, UINT16 nWidth,
+                                    UINT16 nHeight, const RECTANGLE_16* encodeRegion)
+{
+    if (!pending || !encodeRegion)
+        return;
+
+    if (!pending->retry)
+        pending->retryRegion = *encodeRegion;
+    else
+    {
+        pending->retryRegion.left = MIN(pending->retryRegion.left, encodeRegion->left);
+        pending->retryRegion.top = MIN(pending->retryRegion.top, encodeRegion->top);
+        pending->retryRegion.right = MAX(pending->retryRegion.right, encodeRegion->right);
+        pending->retryRegion.bottom = MAX(pending->retryRegion.bottom, encodeRegion->bottom);
+    }
+
+    pending->retrySource = pSrcData;
+    pending->retryStride = nSrcStep;
+    pending->retryWidth = nWidth;
+    pending->retryHeight = nHeight;
+    pending->retryFormat = SrcFormat;
+    pending->retry = TRUE;
+}
