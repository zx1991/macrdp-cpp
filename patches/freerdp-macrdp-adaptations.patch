+static BOOL shadow_client_h264_wait_idle(rdpShadowClient* client)
+{
+    macrdp_h264_encoded_frame encoded = { 0 };
+    BOOL waitStatus = TRUE;
+    int takeStatus = 0;
+
+    if (!client || !client->macrdpH264Worker)
+        return TRUE;
+
+    waitStatus = macrdp_h264_worker_wait_idle(
+        (macrdp_h264_worker*)client->macrdpH264Worker);
+    takeStatus = macrdp_h264_worker_take(
+        (macrdp_h264_worker*)client->macrdpH264Worker, &encoded);
+    macrdp_h264_encoded_frame_free(&encoded);
+    free(client->macrdpH264Pending);
+    client->macrdpH264Pending = nullptr;
+    client->macrdpH264CompletionDeferred = FALSE;
+    return waitStatus && takeStatus >= 0;
