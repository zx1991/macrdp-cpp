+BOOL shadow_multiclient_consume_nowait(void* subscriber)
+{
+	struct rdp_shadow_multiclient_subscriber* s = nullptr;
+	rdpShadowMultiClientEvent* event = nullptr;
+	BOOL last = FALSE;
+
+	if (!subscriber)
+		return last;
+
+	s = (struct rdp_shadow_multiclient_subscriber*)subscriber;
+	event = s->ref;
+
+	EnterCriticalSection(&(event->lock));
+	if (WaitForSingleObject(event->event, 0) == WAIT_OBJECT_0 && s->pleaseHandle)
+	{
+		event->consuming--;
+		s->pleaseHandle = FALSE;
+		if (event->consuming == 0)
+		{
+			(void)ResetEvent(event->event);
+			if (event->waiting > 0)
+				(void)SetEvent(event->barrierEvent);
+			else
+				(void)SetEvent(event->doneEvent);
+			last = TRUE;
+		}
+	}
+	PublishPending(event);
+	WINPR_ASSERT(event->consuming >= 0);
+	LeaveCriticalSection(&(event->lock));
+
+	return last;
+}
+
+BOOL shadow_multiclient_subscriber_pending(void* subscriber)
+{
+	struct rdp_shadow_multiclient_subscriber* s = nullptr;
+	rdpShadowMultiClientEvent* event = nullptr;
+	BOOL pending = FALSE;
+
+	if (!subscriber)
+		return pending;
+
+	s = (struct rdp_shadow_multiclient_subscriber*)subscriber;
+	event = s->ref;
+
+	EnterCriticalSection(&(event->lock));
+	pending = (WaitForSingleObject(event->event, 0) == WAIT_OBJECT_0 && s->pleaseHandle);
+	LeaveCriticalSection(&(event->lock));
+
+	return pending;
 }
