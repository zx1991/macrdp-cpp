+                  "encode_last=%llums encode_avg=%llums encode_max=%llums output=%llu bytes "
+                  "output_deferred=%llu",
+                  (unsigned long long)stats.submitted,
+                  (unsigned long long)stats.completed,
+                  (unsigned long long)client->macrdpH264DeferredFrames,
+                  (unsigned long long)stats.lastEncodeTimeMs,
+                  (unsigned long long)averageEncodeMs,
+                  (unsigned long long)stats.encodeTimeMsMax,
+                  (unsigned long long)stats.outputBytes,
+                  (unsigned long long)client->macrdpH264OutputDeferredFrames);
+        client->macrdpH264LastDiagnostics = diagnosticsNow;
+    }
+    if (takeStatus < 0)
+    {
+        WLog_ERR(TAG, "H.264 worker failed to encode a frame");
+        macrdp_h264_encoded_frame_free(&encoded);
+        free(pending);
+        client->macrdpH264Pending = nullptr;
+        return FALSE;
+    }
+
+    if (!pending)
+    {
+        macrdp_h264_encoded_frame_free(&encoded);
+        return TRUE;
+    }
+
+    retry = pending->retry;
+    retrySource = pending->retrySource;
+    retryStride = pending->retryStride;
+    retryWidth = pending->retryWidth;
+    retryHeight = pending->retryHeight;
+    retryFormat = pending->retryFormat;
+    retryRegion = pending->retryRegion;
+
+    if (takeStatus > 0)
+    {
+        pending->command.codecId = encoded.codecId;
+        if (encoded.codecId == RDPGFX_CODECID_AVC420)
+            pending->command.extra = (void*)&encoded.avc420;
+        else if (encoded.codecId == RDPGFX_CODECID_AVC444 ||
+                 encoded.codecId == RDPGFX_CODECID_AVC444v2)
