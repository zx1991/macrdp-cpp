+static BOOL shadow_client_send_h264_completion(rdpShadowClient* client, BOOL outputBlocked)
+{
+    MACRDP_H264_PENDING* pending = nullptr;
+    macrdp_h264_encoded_frame encoded = { 0 };
+    BOOL retry = FALSE;
+    const BYTE* retrySource = nullptr;
+    UINT32 retryStride = 0;
+    UINT16 retryWidth = 0;
+    UINT16 retryHeight = 0;
+    UINT32 retryFormat = 0;
