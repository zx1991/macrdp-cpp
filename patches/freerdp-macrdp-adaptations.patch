+static BOOL transport_write_queue_append(rdpTransport* transport, wStream* stream, size_t offset,
+                                         size_t length, BOOL priority, BOOL continuation)
+{
+	if (length == 0)
+		return TRUE;
+
+	if (transport->writeQueueBytes > MACRDP_WRITE_QUEUE_LIMIT
+	    || length > MACRDP_WRITE_QUEUE_LIMIT - transport->writeQueueBytes)
+	{
+		WLog_WARN(TAG,
+		          "Non-blocking output queue limit reached (queued=%" PRIuz ", new=%" PRIuz ")",
+		          transport->writeQueueBytes, length);
+		return FALSE;
+	}
+
+	rdpTransportWriteItem* item = (rdpTransportWriteItem*)calloc(1, sizeof(*item));
+	if (!item)
+		return FALSE;
+
+	if (offset > Stream_Length(stream) || length > Stream_Length(stream) - offset)
+	{
+		free(item);
+		return FALSE;
+	}
+
+	item->data = (BYTE*)malloc(length);
+	if (!item->data)
+	{
+		free(item);
+		return FALSE;
+	}
+	memcpy(item->data, Stream_Buffer(stream) + offset, length);
+	item->offset = 0;
+	item->length = length;
+	item->priority = priority;
+	item->continuation = continuation;
+	if (priority)
+	{
+		/* A control PDU may pass only an output PDU that has not started.
+		 * Never split an already submitted PDU on the byte stream. */
+		rdpTransportWriteItem** link = &transport->writeQueueHead;
+		rdpTransportWriteItem* current = transport->writeQueueHead;
+		while (current &&
+		       (current->priority || current->continuation || current->offset > 0))
+		{
+			link = &current->next;
+			current = current->next;
+		}
+		item->next = current;
+		*link = item;
+		if (!current)
+			transport->writeQueueTail = item;
+	}
+	else
+	{
+		if (transport->writeQueueTail)
+			transport->writeQueueTail->next = item;
+		else
+			transport->writeQueueHead = item;
+		transport->writeQueueTail = item;
+	}
+	transport->writeQueueBytes += length;
+	return TRUE;
+}
