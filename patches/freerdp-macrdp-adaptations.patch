+static BOOL transport_write_queue_append(rdpTransport* transport, wStream* stream, size_t offset,
+                                         size_t length)
+{
+	if (length == 0)
+		return TRUE;
+
+	if (transport->writeQueueBytes > MACRDP_WRITE_QUEUE_LIMIT
+	    || length > MACRDP_WRITE_QUEUE_LIMIT - transport->writeQueueBytes)
+	{
+		WLog_WARN(TAG,
+		          "Non-blocking output queue limit reached (queued=%" PRIuz ", new=%" PRIuz ")",
+		          transport->writeQueueBytes, length);
+		return FALSE;
+	}
+
+	rdpTransportWriteItem* item = (rdpTransportWriteItem*)calloc(1, sizeof(*item));
+	if (!item)
+		return FALSE;
+
+	Stream_AddRef(stream);
+	item->stream = stream;
+	item->offset = offset;
+	item->length = length;
+	if (transport->writeQueueTail)
+		transport->writeQueueTail->next = item;
+	else
+		transport->writeQueueHead = item;
+	transport->writeQueueTail = item;
+	transport->writeQueueBytes += length;
+	return TRUE;
