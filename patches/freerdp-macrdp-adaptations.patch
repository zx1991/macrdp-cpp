+static BOOL shadow_client_normalize_h264_region(const RECTANGLE_16* dirtyRegion, UINT16 width,
+                                                UINT16 height, BOOL fullFrame,
+                                                RECTANGLE_16* encodeRegion)
+{
+	UINT32 left = 0;
+	UINT32 top = 0;
+	UINT32 right = 0;
+	UINT32 bottom = 0;
+
+	if (!dirtyRegion || !encodeRegion || width == 0 || height == 0)
+		return FALSE;
+
+	if (fullFrame)
+	{
+		encodeRegion->left = 0;
+		encodeRegion->top = 0;
+		encodeRegion->right = width;
+		encodeRegion->bottom = height;
+		return TRUE;
+	}
 
+	left = MIN((UINT32)dirtyRegion->left, (UINT32)width);
+	top = MIN((UINT32)dirtyRegion->top, (UINT32)height);
+	right = MIN((UINT32)dirtyRegion->right, (UINT32)width);
+	bottom = MIN((UINT32)dirtyRegion->bottom, (UINT32)height);
+	if (left >= right || top >= bottom)
+		return FALSE;
+
+	/* I420 chroma samples cover 2x2 luma pixels. Keep the encoded region
+	 * aligned without changing the desktop surface coordinates. */
+	left &= ~1U;
+	top &= ~1U;
+	if (right < width && (right & 1U) != 0)
+		right++;
+	if (bottom < height && (bottom & 1U) != 0)
+		bottom++;
+	if (right <= left || bottom <= top)
+		return FALSE;
+
+	encodeRegion->left = (UINT16)left;
+	encodeRegion->top = (UINT16)top;
+	encodeRegion->right = (UINT16)right;
+	encodeRegion->bottom = (UINT16)bottom;
+	return TRUE;
+}
