+++ b/libfreerdp/core/transport.c
@@ -162,11 +162,28 @@
 void transport_set_output_priority(rdpTransport* transport, BOOL priority)
 {
 	if (transport)
 		transport->outputPriority = priority;
 }
 
+/* MACRDP_OUTPUT_QUEUE_DIAGNOSTICS */
+size_t transport_get_write_queue_size(rdpTransport* transport)
+{
+	size_t bytes = 0;
+	if (!transport || !transport->haveWriteLock)
+		return 0;
+	EnterCriticalSection(&(transport->WriteLock));
+	bytes = transport->writeQueueBytes;
+	LeaveCriticalSection(&(transport->WriteLock));
+	return bytes;
+}
+
+size_t transport_get_write_queue_limit(void)
+{
+	return MACRDP_WRITE_QUEUE_LIMIT;
+}
