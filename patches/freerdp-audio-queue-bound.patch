 static BOOL shadow_client_dispatch_msg(rdpShadowClient* client, wMessage* message)
 {
 	if (!client || !message)
 		return FALSE;
 
+	if (message->id == SHADOW_MSG_OUT_AUDIO_OUT_SAMPLES_ID)
+	{
+		rdpTransport* transport = client->context.rdp ? client->context.rdp->transport : nullptr;
+		const ULONGLONG now = GetTickCount64();
+		const BOOL transportBlocked = transport && transport_is_write_blocked(transport);
+		const LONGLONG suppressedUntil = InterlockedCompareExchange64(
+			&client->macrdpAudioSuppressedUntil, 0, 0);
+		if (transportBlocked)
+		{
+			(void)InterlockedCompareExchange64(
+				&client->macrdpAudioSuppressedUntil,
+				(LONGLONG)(now + 2000), suppressedUntil);
+		}
+		/* Audio is real-time. Reject it before it enters a blocked transport or
+		 * creates an unbounded MessageQueue backlog. Keep it suppressed briefly
+		 * after recovery so video can drain without an audio burst. */
+		if (!client->activated || !client->rdpsnd || !client->rdpsnd->Activated
+		    || transportBlocked || suppressedUntil > (LONGLONG)now
+		    || InterlockedCompareExchange(
+			       &client->macrdpAudioMessageQueued, TRUE, FALSE) != FALSE)
+		{
+			InterlockedIncrement(&client->macrdpAudioMessagesDropped);
+			return FALSE;
+		}
+	}
+
 	/* Add reference when it is posted */
 	shadow_msg_out_addref(message);
 
 	WINPR_ASSERT(client->MsgQueue);
 	if (MessageQueue_Dispatch(client->MsgQueue, message))
 		return TRUE;
 	else
 	{
 		/* Release the reference since post failed */
 		shadow_msg_out_release(message);
+		if (message->id == SHADOW_MSG_OUT_AUDIO_OUT_SAMPLES_ID)
+			InterlockedExchange(&client->macrdpAudioMessageQueued, FALSE);
 		return FALSE;
 	}
 }
